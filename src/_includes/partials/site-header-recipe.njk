<header class="container container--bg">
  <div class="siteheader siteheader--recipe">
    <div class="siteheader__contentcontainer">
      <h1 class="siteheader__headline">{{ title }}</h1>
      {% if introText %}
        <div class="recipe__intro" itemprop="description">
          {% for t in introText %}
            <p>{{ t }}</p>
          {% endfor %}
        </div>
      {% endif %}
      <div class="recipe__tags">
        <ul class="taglist">
          {%- for tag in tags -%}
            <li>
              <a href="{{ ('/tags/' ~ (tag | slugify) ~ '/') | url }}">
                {{ tag }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
    <div class="siteheader__imagecontainer">
      <picture>
        <source srcset="/assets/img/{{ headerImage }}-7x2.jpg" width="1000" height="286" media="(min-width: 800px)">
          <img class="siteheader__img no-print" src="/assets/img/{{ headerImage }}-16x9.jpg" alt="" width="500" height="281"></picture>
          {% include "partials/details-imageright.njk" %}
        </div>
        <!-- siteheader__imagecontainer -->
      </div>
    </header>